{
  "$schema": "../../node_modules/playhtml/node_modules/wrangler/config-schema.json",
  "name": "ottv2-spectator-test",
  "main": "src/entry/ott-test-worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "Main",
        "class_name": "OttTestGameServer"
      },
      {
        "name": "OTT_LOBBY",
        "class_name": "OttLobbyServer"
      },
      {
        "name": "Lobby",
        "class_name": "OttLobbyStreamServer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "test-v1",
      "new_sqlite_classes": ["OttTestGameServer"]
    },
    {
      "tag": "test-v2",
      "new_sqlite_classes": ["OttLobbyServer"]
    },
    {
      "tag": "test-v3",
      "new_sqlite_classes": ["OttLobbyStreamServer"]
    }
  ],
  "vars": {
    "OTT_INTERNAL_SECRET": "ott-test-internal-only",
    "OTT_TEST_PROBE_SECRET": "ott-test-probe-local-only",
    "OTT_SPECTATOR_ENABLED": "true",
    "OTT_TEST_CLOCK_MS": "30000",
    "OTT_TEST_RECONNECT_GRACE_MS": "5000",
    "OTT_TEST_CREATOR_ATTACH_TTL_MS": "5000",
    "OTT_BROWSER_ORIGIN": "http://127.0.0.1:3000"
  }
}
